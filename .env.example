# SENTINEL environment template. Copy to .env (which is .gitignored).
# Spec §10: DEMO MODE is the deterministic-orchestration mode used on stage.
# The security pipeline is LIVE in both modes — only the agent driver differs.

# Mode flag (the spec's "demo mode"; NOT labeled "mock" in user-facing surfaces).
# Accepts: 1 / true / yes (DEMO MODE) or 0 / false / no (AZURE MODE).
SENTINEL_DEMO_MODE=1

# --- authentication -----------------------------------------------------------
# Required for anything reachable from a network. With neither this nor
# SENTINEL_ALLOW_ANONYMOUS set, SENTINEL refuses to serve rather than serving
# openly, so forgetting to configure it is not the same as choosing to have none.
# SENTINEL_API_TOKEN=change-me
#
# Serving more than one tenant? Map tenant -> token instead. Each token
# authenticates as its tenant and sees only that tenant's runs; the tenant named
# in a request body is a claim and is refused when it contradicts the credential.
# SENTINEL_API_TOKENS={"acme":"...","globex":"..."}
#
# Give a tenant its own policy. Without an entry, a tenant with a credential uses
# the deployment policy (SENTINEL_POLICY_FILE, or the bundled example).
# SENTINEL_TENANT_POLICIES={"acme":"policies/acme.yaml"}
#
# The OPERATOR credential: the only one that may replace a policy or clear a
# quarantine. Keep it away from agents. Tenant tokens are what agents hold, and
# an agent that could administer could switch off its own guardrails. With
# per-tenant tokens and no admin token, nobody can administer.
# SENTINEL_ADMIN_TOKEN=change-me-too
#
# Run with NO authentication. Local offline demo only, never on a network.
# SENTINEL_ALLOW_ANONYMOUS=1

# --- Azure Foundry (Agent Service) ---
# Endpoint of the Foundry project. Only used in AZURE MODE.
AZURE_AI_PROJECT_ENDPOINT=

# --- Azure Cosmos (forensic store) ---
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=sentinel
AZURE_COSMOS_CONTAINER=spans

# --- Content Safety (Prompt Shields, REST) ---
# Per §5: KEY-BASED at the API; the key is pulled from Key Vault via managed
# identity in prod, or from this env var in dev.
# Layer-1 injection shield: auto (Azure if configured, else the free local
# detector), local, or azure. It only flags; enforcement never depends on it.
SENTINEL_SHIELD=auto
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# --- Azure OpenAI (semantic classifier + the live agent model) ---
# Also used by the DEFAULT agent path: when the endpoint + deployment are set, runs
# are driven by a real model over identity auth (DefaultAzureCredential).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Live agent model (OpenAI) ---
# The DEFAULT agent is a REAL LLM whenever a credential is configured: set this (or
# the Azure OpenAI pair above) and the model decides the actions while SENTINEL is
# the backstop. With NO credential, runs fall back to the deterministic scripted
# transcript, so offline/CI stays key-free and reproducible.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-COMPATIBLE endpoint — lets you run a real model with NO paid key.
#   Ollama (local, free):  OPENAI_BASE_URL=http://localhost:11434/v1
#                          OPENAI_MODEL=llama3.2          (no API key needed)
#   Groq / Gemini compat:  set OPENAI_BASE_URL to the provider's /v1 URL plus a
#                          free-tier OPENAI_API_KEY.
# Leave blank to use api.openai.com (or no live model at all).
OPENAI_BASE_URL=

# --- Tool-catalogue integrity ---
# 1 (default, secure) = REFUSE to serve a downstream catalogue whose tool
# definitions carry prompt-injection markers (tool poisoning). A poisoned tool
# DESCRIPTION subverts the agent before anything is retrieved, so provenance
# alone cannot catch it. 0 = flag-only triage.
# Cross-server tool-name shadowing always fails closed regardless of this flag.
# Also decides what happens to a tool whose definition changes AFTER approval:
# 1 = its calls are refused until SENTINEL restarts; 0 = reported only. A tool
# that was never in the approved catalogue is refused either way.
SENTINEL_CATALOGUE_STRICT=1
# Seconds between scheduled re-checks of each downstream catalogue against the
# one approved at connect. Default 300; 0 = only when an agent lists tools.
SENTINEL_CATALOGUE_RECHECK_SECONDS=

# --- Real web_fetch ---
# 1 = the `web` tool performs a REAL, SSRF-guarded HTTP GET of the requested URL
# (so the agent can research arbitrary live pages, and that content is tainted as
# RETRIEVED_CONTENT like any other tool result). 0/unset = canned demo pages.
SENTINEL_REAL_WEB_FETCH=0

# --- OpenTelemetry / Azure Monitor ---
# Optional; when unset and DEMO MODE is on, the tracer emits to a no-op exporter.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- SENTINEL MCP proxy ---
# URL the protected agent uses to reach SENTINEL.
SENTINEL_MCP_URL=http://localhost:8765/mcp

# --- YOUR downstream MCP servers (the product path) ---
# Declare the MCP servers YOU want secured. SENTINEL connects to each, DISCOVERS
# its tools, and builds routing from that discovery — it proxies servers it has
# never seen, and ships no tools of its own. Unset = the bundled example servers.
#   [{"name":"github","url":"https://mcp.example/gh"},{"name":"jira","url":"..."}]
# An object mapping name->url also works: {"github":"https://mcp.example/gh"}
# NOTE: discovery does NOT grant permission. A discovered tool with no policy rule
# is default-denied until you write one (see authorization/policies/default.yaml).
SENTINEL_MCP_SERVERS=

# --- Resource limits ---
# Caps that stop one caller exhausting the service. Defaults sit well above
# normal use; blank = default. A value that is not a whole number is a startup
# error, not a silent fallback.
# Request body bytes (413 above). Default 4194304.
SENTINEL_MAX_BODY_BYTES=
# Requests per minute per tenant, or per client address without a valid
# credential (429 above; 0 = off). Default 600.
SENTINEL_RATE_LIMIT_PER_MINUTE=
# Runs in flight per tenant (429 above). Default 8.
SENTINEL_MAX_ACTIVE_RUNS=
# Finished runs kept in the in-memory run index. Default 1000.
SENTINEL_MAX_RETAINED_RUNS=
# Concurrent live-stream clients (503 above). Default 100.
SENTINEL_MAX_SSE_SUBSCRIBERS=
# Largest tool result passed on to the agent, in bytes. Default 1048576.
SENTINEL_MAX_RESULT_BYTES=
# Days a trace is kept in the SQLite forensic store after its last span;
# older traces are deleted whole. Default 90; 0 = keep forever.
SENTINEL_FORENSIC_RETENTION_DAYS=
# Behind a reverse proxy, let uvicorn read the real client address from it:
# the proxy's address or CIDR, never "*" on a host clients can reach directly.
# FORWARDED_ALLOW_IPS=10.0.0.0/8
