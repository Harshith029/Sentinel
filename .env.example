# Whence environment template. Copy to .env (which is .gitignored).
# Spec §10: DEMO MODE is the deterministic-orchestration mode used on stage.
# The security pipeline is LIVE in both modes — only the agent driver differs.

# Mode flag (the spec's "demo mode"; NOT labeled "mock" in user-facing surfaces).
# Accepts: 1 / true / yes (DEMO MODE) or 0 / false / no (AZURE MODE).
WHENCE_DEMO_MODE=1

# --- Azure Foundry (Agent Service) ---
# Endpoint of the Foundry project. Only used in AZURE MODE.
AZURE_AI_PROJECT_ENDPOINT=

# --- Azure Cosmos (forensic store) ---
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=whence
AZURE_COSMOS_CONTAINER=spans

# --- Content Safety (Prompt Shields, REST) ---
# Per §5: KEY-BASED at the API; the key is pulled from Key Vault via managed
# identity in prod, or from this env var in dev.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# --- Azure OpenAI (semantic classifier + the live agent model) ---
# Also used by the DEFAULT agent path: when the endpoint + deployment are set, runs
# are driven by a real model over identity auth (DefaultAzureCredential).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Live agent model (OpenAI) ---
# The DEFAULT agent is a REAL LLM whenever a credential is configured: set this (or
# the Azure OpenAI pair above) and the model decides the actions while Whence is
# the backstop. With NO credential, runs fall back to the deterministic scripted
# transcript, so offline/CI stays key-free and reproducible.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-COMPATIBLE endpoint — lets you run a real model with NO paid key.
#   Ollama (local, free):  OPENAI_BASE_URL=http://localhost:11434/v1
#                          OPENAI_MODEL=llama3.2          (no API key needed)
#   Groq / Gemini compat:  set OPENAI_BASE_URL to the provider's /v1 URL plus a
#                          free-tier OPENAI_API_KEY.
# Leave blank to use api.openai.com (or no live model at all).
OPENAI_BASE_URL=

# --- Tool-catalogue integrity ---
# 1 (default, secure) = REFUSE to serve a downstream catalogue whose tool
# definitions carry prompt-injection markers (tool poisoning). A poisoned tool
# DESCRIPTION subverts the agent before anything is retrieved, so provenance
# alone cannot catch it. 0 = flag-only triage.
# Cross-server tool-name shadowing always fails closed regardless of this flag.
WHENCE_CATALOGUE_STRICT=1

# --- Real web_fetch ---
# 1 = the `web` tool performs a REAL, SSRF-guarded HTTP GET of the requested URL
# (so the agent can research arbitrary live pages, and that content is tainted as
# RETRIEVED_CONTENT like any other tool result). 0/unset = canned demo pages.
WHENCE_REAL_WEB_FETCH=0

# --- OpenTelemetry / Azure Monitor ---
# Optional; when unset and DEMO MODE is on, the tracer emits to a no-op exporter.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Whence MCP proxy ---
# URL the protected agent uses to reach Whence.
WHENCE_MCP_URL=http://localhost:8765/mcp

# --- YOUR downstream MCP servers (the product path) ---
# Declare the MCP servers YOU want secured. Whence connects to each, DISCOVERS
# its tools, and builds routing from that discovery — it proxies servers it has
# never seen, and ships no tools of its own. Unset = the bundled example servers.
#   [{"name":"github","url":"https://mcp.example/gh"},{"name":"jira","url":"..."}]
# An object mapping name->url also works: {"github":"https://mcp.example/gh"}
# NOTE: discovery does NOT grant permission. A discovered tool with no policy rule
# is default-denied until you write one (see authorization/policies/default.yaml).
WHENCE_MCP_SERVERS=
